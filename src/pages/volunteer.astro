---
// There is no standalone volunteer page by design — every volunteer link
// routes to the contact form with "Sign up to volunteer" pre-checked.
const target = "/contact/?interest=volunteer";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Volunteer | North Shore Red</title>
  </head>
  <body>
    <p>Sign up to volunteer on our <a href={target}>contact page</a>.</p>
  </body>
</html>
