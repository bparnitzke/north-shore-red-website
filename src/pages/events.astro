---
// There is no separate events page — the design promotes one event at a time
// on the homepage, with day-to-day updates carried by the social accounts.
const target = "/#next-event";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Events | North Shore Red</title>
  </head>
  <body>
    <p>Our events live on the <a href={target}>homepage</a>.</p>
  </body>
</html>
