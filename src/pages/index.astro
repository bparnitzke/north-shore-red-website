---
import BaseLayout from "../layouts/BaseLayout.astro";
import FigureList from "../components/FigureList.astro";
import SocialFollowList from "../components/SocialFollowList.astro";
import { followAlong, letter, nextEvent, volunteerAreas } from "../data/homepage";
import { founderPhoto, recordFigures, recordNote } from "../data/record";
import { site } from "../data/site";
---

<BaseLayout
  title="North Shore Red"
  description={site.description}
  footerVariant="full"
>
  <section class="band band--hero">
    <span class="eyebrow" style="padding-bottom: 20px; display: block;">01 — Who we are</span>
    <h1 style="max-width: 22ch; margin-bottom: 20px;">Grassroots work. Local decisions. Measurable results.</h1>
    <p class="lead" style="margin-bottom: 24px;">
      North Shore Red is a Wisconsin 501(c)(4) organization promoting conservative principles across the North
      Shore, Milwaukee County, and at every level of government. We are led entirely by volunteers — which is
      why 100% of your contribution goes toward helping elect conservatives.
    </p>
    <div style="display:flex; gap:14px; flex-wrap: wrap;">
      <a class="btn btn--primary" href={site.donationUrl} target="_blank" rel="noopener">Donate</a>
      <a class="btn btn--secondary" href="/contact/?interest=volunteer">Volunteer with us</a>
    </div>
  </section>

  <section class="band">
    <div class="marker-row" style="padding-bottom: 6px;">
      <span class="eyebrow">02 — From the field</span>
      <span class="meta">Facebook · Instagram · X</span>
    </div>
    <h3 style="margin-bottom: 8px;">{followAlong.heading}</h3>
    <p class="prose" style="margin-bottom: 26px; max-width: 64ch;">{followAlong.body}</p>
    <SocialFollowList links={followAlong.links} />
  </section>

  <section class="band band--ink letter-band">
    <div class="letter-band__label">
      <span class="eyebrow" style="padding-bottom: 14px; display:block;">03 — A letter</span>
      <div class="meta" style="color: var(--meta-on-ink-soft)">From the founding board</div>
    </div>
    <div>
      <p class="letter-band__lead">{letter.lead}</p>
      <p class="prose" style="margin-bottom: 16px; max-width: 66ch;">{letter.body[0]}</p>
      <div class="letter-band__signoff">
        <span class="letter-band__signature">{letter.signoff}</span>
        <a class="btn btn--on-ink" href="/about/" style="margin-left: auto; white-space: nowrap;">Read the full story</a>
      </div>
    </div>
  </section>

  <section class="record-band">
    <div class="record-band__photo">
      <img src={founderPhoto.src} alt={founderPhoto.alt} />
      <div class="record-band__caption">
        {founderPhoto.captionName} <span class="meta" style="color: var(--meta-on-ink)">{founderPhoto.captionDate}</span>
      </div>
    </div>
    <div class="record-band__figures">
      <span class="eyebrow" style="padding-bottom: 18px; display:block;">04 — The record</span>
      <FigureList figures={recordFigures} note={recordNote} />
    </div>
  </section>

  <section class="band">
    <span class="eyebrow" style="padding-bottom: 20px; display:block;">05 — Where we need people</span>
    <div class="columns-4 ruled-columns">
      {volunteerAreas.map((area) => (
        <div>
          <h4 style="margin-bottom: 8px;">{area.title}</h4>
          <p class="prose prose--small" style="color: var(--body-muted)">{area.body}</p>
        </div>
      ))}
    </div>
    <a class="btn btn--primary" href="/contact/?interest=volunteer" style="display:inline-block; margin-top:24px;">Tell us where you fit</a>
  </section>

  <section class="band band--paper-alt" id="next-event">
    <div class="marker-row">
      <span class="eyebrow">06 — Our next event</span>
    </div>
    <div class="event-spotlight">
      <div class="event-spotlight__date">
        <div class="meta" style="padding-bottom: 8px;">{nextEvent.dateLabel}</div>
        <div class="event-spotlight__day">{nextEvent.month}<br />{nextEvent.day}</div>
        <div class="event-spotlight__time">{nextEvent.weekday}<br />{nextEvent.time}</div>
      </div>
      <div class="event-spotlight__body">
        <h3 style="margin-bottom: 10px;">{nextEvent.name}</h3>
        <p class="prose" style="margin-bottom: 14px; max-width: 56ch;">{nextEvent.description}</p>
        <div class="event-spotlight__details">
          {nextEvent.details.map((detail) => (
            <div>
              <div class="meta" style="padding-bottom: 5px;">{detail.label}</div>
              <div class="event-spotlight__detail-value">{detail.value}</div>
            </div>
          ))}
        </div>
        <div class="meta" style="padding-top: 14px;">{nextEvent.hostNote}</div>
      </div>
      <div class="event-spotlight__cta">
        <a class="btn btn--primary" href="/contact/?interest=event">Join the invitation list</a>
        <p class="prose prose--small" style="color: var(--body-muted);">Invitations go out to people on the list. Adding your name is the first step, not a ticket purchase.</p>
      </div>
    </div>
    <p class="prose prose--small" style="color: var(--body-muted); max-width: 70ch; margin-top: 18px;">{nextEvent.footNote}</p>
  </section>

  <section class="band columns-2">
    <div>
      <span class="eyebrow" style="padding-bottom: 16px; display:block;">07 — Voting</span>
      <h3 style="margin-bottom: 12px;">Make a voting plan</h3>
      <p class="prose" style="margin-bottom: 18px;">
        Pick how you want to vote — absentee, early in person, or on election day — and we hand you off to
        MyVote Wisconsin, the state's official system, to register, request a ballot or find your polling place.
      </p>
      <a class="link-arrow" href={site.votingPlanUrl ?? "/make-a-plan/"} target={site.votingPlanUrl ? "_blank" : undefined} rel={site.votingPlanUrl ? "noopener" : undefined}>Start your plan →</a>
    </div>
    <div>
      <span class="eyebrow" style="padding-bottom: 16px; display:block;">08 — Why donate to us</span>
      <h3 style="margin-bottom: 12px;">No salaries, no consultants</h3>
      <p class="prose" style="margin-bottom: 18px;">
        Nobody is paid for their efforts on behalf of North Shore Red. Contributions buy postcards, printing,
        yard signs, room rentals and direct support for conservative candidates — allocated by volunteers who
        live in these villages.
      </p>
      <a class="link-arrow" href="/donate/">Read where money goes →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .letter-band {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 48px;
    align-items: start;
  }

  .letter-band__lead {
    font: 300 22px/1.45 var(--font-body);
    color: #fff;
    max-width: 58ch;
    margin: 0 0 20px;
  }

  .letter-band__signoff {
    display: flex;
    align-items: center;
    gap: 20px;
    border-top: 1px solid var(--rule-dark);
    padding-top: 20px;
    flex-wrap: wrap;
  }

  .letter-band__signature {
    font: 400 15px/1.5 var(--font-body);
    color: var(--body-on-ink-muted);
    font-style: italic;
  }

  @media (max-width: 899.98px) {
    .letter-band {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .record-band {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--rule);
  }

  .record-band__photo {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-right: 1px solid var(--rule);
  }

  .record-band__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
  }

  .record-band__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(31, 39, 42, 0.86);
    color: #e9e5dd;
    padding: 14px 18px;
    font: 400 14px/1.55 var(--font-body);
  }

  .record-band__figures {
    padding: 44px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (max-width: 899.98px) {
    .record-band {
      grid-template-columns: 1fr;
    }

    .record-band__photo {
      aspect-ratio: 3 / 2;
      border-right: none;
      border-bottom: 1px solid var(--rule);
    }

    .record-band__figures {
      padding: 24px 18px;
    }
  }

  .event-spotlight {
    display: grid;
    grid-template-columns: 168px 1fr 240px;
    gap: 40px;
    align-items: center;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    padding: 28px 0;
  }

  .event-spotlight__day {
    font: 600 46px/0.95 var(--font-heading);
    letter-spacing: 0;
  }

  .event-spotlight__time {
    font: 500 13px/1.5 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--body-muted);
    padding-top: 8px;
  }

  .event-spotlight__details {
    display: flex;
    border-top: 1px solid var(--rule);
    max-width: 56ch;
    margin-top: 14px;
  }

  .event-spotlight__details > div {
    padding: 12px 20px 0 0;
    border-right: 1px solid var(--rule);
  }

  .event-spotlight__details > div:first-child {
    padding-left: 0;
  }

  .event-spotlight__details > div:last-child {
    border-right: none;
    padding-right: 0;
  }

  .event-spotlight__detail-value {
    font: 600 20px/1 var(--font-heading);
  }

  .event-spotlight__cta {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media (max-width: 899.98px) {
    .event-spotlight {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 18px 0 0;
    }

    .event-spotlight__details {
      flex-wrap: wrap;
    }
  }
</style>
