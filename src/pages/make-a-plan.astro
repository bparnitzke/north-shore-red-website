---
import BaseLayout from "../layouts/BaseLayout.astro";
import EarlyVoteCommitmentForm from "../components/EarlyVoteCommitmentForm.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Commit to Vote Early"
  description="Watch a short message, commit to vote early, and continue to Wisconsin's official MyVote resource."
>
  <section class="band band--hero voting-hero">
    <div>
      <span class="eyebrow voting-hero__eyebrow">Wisconsin voting</span>
      <h1>Vote early.<br />Make it count.</h1>
    </div>
    <div class="voting-hero__intro">
      <p class="lead">
        Election Day does not have to be the only plan. Commit now to cast your ballot early, then use
        Wisconsin's official MyVote site to confirm the information that applies to you.
      </p>
      <div class="voting-hero__actions">
        <a class="btn btn--primary" href="#commitment-card">Commit to vote early</a>
        <a class="link-arrow" href={site.myVoteUrl} target="_blank" rel="noopener">Check MyVote Wisconsin →</a>
      </div>
      <p class="meta voting-hero__note">MyVote is an official state resource · Opens in a new tab</p>
    </div>
  </section>

  <section class="band video-band" aria-labelledby="voting-video-title">
    <div class="video-band__heading">
      <span class="eyebrow">A 29-second message</span>
      <h2 id="voting-video-title">Vote Early, Wisconsin</h2>
    </div>
    <div class="video-band__frame">
      <video
        controls
        playsinline
        preload="metadata"
        poster="/assets/video/vote-early-wisconsin-poster.jpg"
        aria-label="Vote Early, Wisconsin video"
      >
        <source src="/assets/video/vote-early-wisconsin.mp4" type="video/mp4" />
        Your browser does not support this video. You can
        <a href="/assets/video/vote-early-wisconsin.mp4">open the video file directly</a>.
      </video>
    </div>
  </section>

  <section class="band commitment-band" id="commitment-card" aria-labelledby="commitment-title">
    <div class="commitment-band__intro">
      <span class="eyebrow">Early-vote commitment</span>
      <h2 id="commitment-title">Put your commitment on the record.</h2>
      <p class="prose">
        Tell us how you intend to vote early. We collect only the choice needed for this commitment, not your
        date of birth, street address, or government voting record.
      </p>
      <p class="prose prose--small commitment-band__note">
        Email updates and text messages are optional, separate choices. Neither is required to submit your
        commitment or use MyVote Wisconsin.
      </p>
    </div>
    <EarlyVoteCommitmentForm />
  </section>

  <section class="band band--ink myvote-handoff">
    <div>
      <span class="eyebrow">Official election information</span>
      <h2>Confirm your official voting information</h2>
      <p class="prose">
        MyVote Wisconsin is operated by the Wisconsin Elections Commission. North Shore Red does not receive
        the information you enter on the state website.
      </p>
    </div>
    <div class="myvote-handoff__action">
      <a class="btn btn--primary" href={site.myVoteUrl} target="_blank" rel="noopener">
        Continue to MyVote Wisconsin
      </a>
      <p class="meta">myvote.wi.gov · Opens in a new tab</p>
    </div>
  </section>
</BaseLayout>

<style>
  .voting-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(340px, 1.1fr);
    gap: 64px;
    align-items: end;
    background: var(--paper-alt);
  }

  .voting-hero__eyebrow {
    margin-bottom: 20px;
  }

  .voting-hero h1 {
    max-width: 12ch;
  }

  .voting-hero__intro {
    border-top: 3px solid var(--red);
    padding-top: 22px;
  }

  .voting-hero__intro .lead {
    margin-bottom: 24px;
  }

  .voting-hero__actions {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .voting-hero__note {
    margin-top: 12px;
  }

  .video-band {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  .video-band__heading .eyebrow {
    margin-bottom: 18px;
  }

  .video-band__heading h2 {
    font-size: 31px;
    line-height: 1.05;
  }

  .video-band__frame {
    border-top: 4px solid var(--red);
    background: var(--ink);
  }

  .video-band video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }

  .commitment-band {
    display: grid;
    grid-template-columns: minmax(250px, 0.7fr) minmax(0, 1.3fr);
    gap: 64px;
    background: var(--paper-alt);
    align-items: start;
  }

  .commitment-band__intro {
    position: sticky;
    top: 24px;
  }

  .commitment-band__intro .eyebrow {
    margin-bottom: 18px;
  }

  .commitment-band__intro h2 {
    max-width: 18ch;
    margin-bottom: 16px;
  }

  .commitment-band__note {
    border-top: 1px solid var(--rule);
    margin-top: 22px;
    padding-top: 16px;
  }

  .myvote-handoff {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 56px;
    align-items: center;
  }

  .myvote-handoff .eyebrow {
    margin-bottom: 16px;
  }

  .myvote-handoff h2 {
    margin-bottom: 12px;
  }

  .myvote-handoff .prose {
    max-width: 64ch;
  }

  .myvote-handoff__action {
    min-width: 290px;
    text-align: center;
  }

  .myvote-handoff__action .meta {
    margin-top: 12px;
    color: var(--meta-on-ink);
  }

  @media (max-width: 899.98px) {
    .voting-hero,
    .video-band,
    .commitment-band,
    .myvote-handoff {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .voting-hero {
      align-items: start;
    }

    .commitment-band__intro {
      position: static;
    }

    .video-band__heading h2 {
      font-size: 28px;
    }

    .myvote-handoff__action {
      min-width: 0;
      text-align: left;
    }
  }
</style>
