---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Make a Voting Plan"
  description="Make a voting plan and get routed to official Wisconsin election resources."
  noindex={true}
>
  <section class="band band--hero">
    <span class="eyebrow" style="padding-bottom: 20px; display: block;">Future tool</span>
    <h1 style="max-width: 26ch; margin-bottom: 20px;">Make a voting plan</h1>
    <p class="lead" style="max-width: 60ch; margin-bottom: 26px;">
      This page is reserved for a future tool that walks Wisconsin voters through choosing how to vote and
      building a plan, then hands them off to MyVote Wisconsin — the state's official system — to register,
      request a ballot, or find a polling place. Until that tool is built, use the official state resource
      directly below.
    </p>
    <a class="btn btn--primary" href={site.myVoteUrl} target="_blank" rel="noopener">Visit MyVote Wisconsin</a>
  </section>
</BaseLayout>
