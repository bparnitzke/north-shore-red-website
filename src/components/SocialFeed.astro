---
import feed from "../data/social.generated.json";

type SocialPost = {
  id: string;
  platform: "Facebook" | "Instagram" | "X";
  publishedAt: string;
  text: string;
  url: string;
  imageUrl?: string;
};

const posts = (feed.posts as SocialPost[]).slice(0, 6);
const formatDate = (value: string) =>
  new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(new Date(value));
---

{posts.length > 0 ? (
  <div class="social-feed" aria-label="Recent social posts">
    {posts.map((post) => (
      <article class:list={["social-post", { "social-post--with-image": post.imageUrl }]}>
        {post.imageUrl && (
          <a class="social-post__image" href={post.url} target="_blank" rel="noopener" aria-label={`View this ${post.platform} post`}>
            <img src={post.imageUrl} alt="" loading="lazy" decoding="async" />
          </a>
        )}
        <div class="social-post__body">
          <div class="social-post__meta">
            <span>{post.platform}</span>
            <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
          </div>
          <p>{post.text}</p>
          <a class="social-post__link" href={post.url} target="_blank" rel="noopener">View post <span aria-hidden="true">→</span></a>
        </div>
      </article>
    ))}
  </div>
) : (
  <div class="social-feed-empty">
    <p class="prose">Follow North Shore Red on the profiles below for activity from the field.</p>
  </div>
)}

<style>
  .social-feed {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
    margin-bottom: 28px;
  }

  .social-post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    min-height: 240px;
  }

  .social-post:nth-child(even) {
    border-right: 0;
  }

  .social-post--with-image {
    grid-template-columns: minmax(132px, 0.72fr) minmax(0, 1fr);
  }

  .social-post__image {
    min-height: 240px;
    overflow: hidden;
    background: var(--paper-alt);
  }

  .social-post__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .social-post__body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .social-post__meta {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    font: 500 10px/1.5 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--meta);
  }

  .social-post__meta span {
    color: var(--red);
  }

  .social-post p {
    font: 400 16px/1.65 var(--font-body);
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .social-post__link {
    margin-top: auto;
    font-weight: 600;
    color: var(--red);
  }

  .social-feed-empty {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    padding: 22px 0;
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  @media (max-width: 1040px) {
    .social-post--with-image {
      grid-template-columns: 1fr;
    }

    .social-post__image {
      aspect-ratio: 16 / 9;
      min-height: 0;
    }
  }

  @media (max-width: 699px) {
    .social-feed {
      grid-template-columns: 1fr;
    }

    .social-post,
    .social-post:nth-child(even) {
      border-right: 0;
      min-height: 0;
    }

  }
</style>
