---
import { footerNav, site } from "../data/site";

export interface Props {
  variant?: "full" | "simple";
}

const { variant = "simple" } = Astro.props;
---

<footer class="footer">
  <div class="footer__legal">
    {site.legalDisclaimer}
    <br />
    <span class="footer__copyright">© <span class="js-year">2026</span> {site.name}</span>
  </div>

  {variant === "full" ? (
    <div class="footer__links">
      <div class="footer__link-group">
        <span class="footer__link-group-label">Site</span>
        {footerNav.site.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="footer__link-group">
        <span class="footer__link-group-label">Connect</span>
        {footerNav.connect.map((item) => (
          <a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener" : undefined}>
            {item.label}
          </a>
        ))}
      </div>
    </div>
  ) : (
    <div class="footer__link-group">
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/terms-and-conditions/">Terms of Use</a>
      <a href="/contact/">Contact</a>
    </div>
  )}
</footer>

<script>
  document.querySelectorAll(".js-year").forEach((el) => {
    el.textContent = String(new Date().getFullYear());
  });
</script>
